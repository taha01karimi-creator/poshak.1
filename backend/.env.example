# Copy to backend/.env and fill in. Never commit the real .env file.
# Generate secrets with:
#   python -c "import secrets; print('SECRET_KEY='+secrets.token_hex(48)); print('JWT_SECRET_KEY='+secrets.token_hex(48))"

SECRET_KEY=
JWT_SECRET_KEY=

# Optional: defaults to SQLite in backend/. For Postgres:
# DATABASE_URL=postgresql://user:password@host:5432/digistyle
DATABASE_URL=

# Front-end origins allowed to call the API with credentials.
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8000,http://127.0.0.1:8000

# Set to 1 when the site is served over HTTPS (required in production).
COOKIE_SECURE=0

# Create missing tables on boot (dev convenience; use migrations otherwise).
AUTO_CREATE_TABLES=1

# Seed accounts/products when the database is empty (handy on a fresh host).
SEED_ON_BOOT=0

# Initial passwords for `python seed.py`. When empty, a random password is
# generated and printed once.
SEED_OWNER_PASSWORD=
SEED_ADMIN_PASSWORD=
